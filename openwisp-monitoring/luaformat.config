# LuaFormatter can exceed its configured limit by one character.
column_limit: 109
indent_width: 2
tab_width: 2
continuation_indent_width: 2
column_table_limit: 109
line_breaks_after_function_body: 1
align_args: false
align_parameter: false
# Simple one-line functions can bypass column_limit.
keep_simple_function_one_line: false
